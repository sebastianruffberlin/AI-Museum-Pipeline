# ================================================================
# AI Museum Pipeline installer secrets
#
# Copy to .env and chmod 600 .env
#
# Internal PostgreSQL/LiteLLM/llama-swap secrets are generated
# automatically when omitted.
# ================================================================

# ------------------------------------------------
# Hugging Face
# ------------------------------------------------
# Required for a fresh deployment using gated DINOv3.
# The account itself must have access to the DINOv3 repository.
HF_TOKEN=

# ------------------------------------------------
# S3 / Object Storage
# Required only when features.s3=true
# ------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ------------------------------------------------
# External GPU mode only
# Do not set these for gpu.mode=managed.
# ------------------------------------------------
LCPP_URL=
LCPP_AUTH=

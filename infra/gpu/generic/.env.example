# Deployment identity
GPU_COMPOSE_PROJECT=museum-pipeline-gpu
GPU_DOMAIN=gpu.example.org

# IP address of the CPU/orchestrator host allowed to call this GPU.
ALLOWED_REMOTE_IP=203.0.113.10

# Absolute host path containing llama-swap.yaml and litellm.yaml.
GPU_CONFIG_DIR=/opt/museum-pipeline-gpu-config

# Host directory containing model files.
MODELS_DIR=/mnt/models

# Authentication
LITELLM_MASTER_KEY=CHANGE_ME
LLAMA_SWAP_API_KEY=CHANGE_ME

# Images.
# Pinned to exact digests that were verified as a tested reference
# combination (see docs/REPRODUCIBILITY.md). Override with a floating tag
# (e.g. ":latest", ":cuda", ":main-latest") if you deliberately want to
# track upstream instead.
LLAMA_SWAP_IMAGE=ghcr.io/mostlygeek/llama-swap@sha256:686afd4625e3728ed451c56fa09dd4ca544425fd12254aa6102d3eee56495706
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:3a1980074ff2ac13883e0ffee1bebec345d8addd004be251079cee173b0e8305
CADDY_IMAGE=caddy@sha256:df7f1c2fb114453b951de51a98efc010db1655a92c2e86be6706714e2417a78d

# Stadtmuseum Berlin H100 80 GB reference deployment.
#
# Copy to a private .env and set the deployment-specific values.

GPU_COMPOSE_PROJECT=museum-pipeline-h100

# Deployment-specific, never commit the real values.
GPU_DOMAIN=gpu-h100.example.org
ALLOWED_REMOTE_IP=203.0.113.10

# Absolute path to this directory on the GPU host.
GPU_CONFIG_DIR=/opt/museum-pipeline/infra/gpu/stadtmuseum-berlin/h100-80gb

# Verified reference host model mount.
MODELS_DIR=/mnt/models

LITELLM_MASTER_KEY=CHANGE_ME
LLAMA_SWAP_API_KEY=CHANGE_ME

# Current reference image families.
LLAMA_SWAP_IMAGE=ghcr.io/mostlygeek/llama-swap@sha256:686afd4625e3728ed451c56fa09dd4ca544425fd12254aa6102d3eee56495706
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:3a1980074ff2ac13883e0ffee1bebec345d8addd004be251079cee173b0e8305
CADDY_IMAGE=caddy@sha256:df7f1c2fb114453b951de51a98efc010db1655a92c2e86be6706714e2417a78d

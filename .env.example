# --- Runtime selection -------------------------------------------------------
# Required: profile directory name below profiles/
# Example: MUSEUM_PROFILE=my-museum
MUSEUM_PROFILE=
MODEL_PROFILE=reference
HARDWARE_PROFILE=h100-80gb
WORKFLOW=core
MUSEUM_PIPELINE_HOME=/opt/museum-pipeline
MUSEUM_RUN_SCHEMA=pipeline_runtime

# --- Postgres ---------------------------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=museum
PG_USER=museum
PG_PASSWORD=CHANGE_ME

# --- LLM gateway (LiteLLM / llama-swap / llama.cpp, OpenAI-compatible) ------
LCPP_URL=https://lcpp-gpu.example.org/v1/chat/completions
# Full HTTP Authorization header value, including the Bearer prefix.
LCPP_AUTH="Bearer CHANGE_ME"
LCPP_TIMEOUT=600
LCPP_CONNECT_TIMEOUT=12
LCPP_MAX_RETRIES=4
LLM_BACKEND=gpu

# --- Embedding + image presign ---------------------------------------------
EMBED_BASE=http://127.0.0.1:8081
# Required only for source.asset.mode: s3
PRESIGN_URL=
EMBED_TIMEOUT=300
PRESIGN_TIMEOUT=30
PRESIGN_EXPIRES=3600

# --- S3-compatible object storage -------------------------------------------
# Required only when the museum profile uses source.asset.mode: s3.
# Use a full URL where possible, e.g. https://s3.example.org or
# http://minio:9000. Legacy host-only values remain supported.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Authority service / GND reference adapter -----------------------------
OS_MSEARCH=http://127.0.0.1:9200/_msearch
OS_INDEX=gnd_sachbegriffe
OS_TIMEOUT=30

# --- Prompt variant: reference or cache ------------------------------------
PROMPT_VARIANT=reference

# --- Phoenix / OpenTelemetry ------------------------------------------------
PHOENIX_ENABLED=0
PHOENIX_ENDPOINT=http://phoenix:4318/v1/traces
PHOENIX_PROJECT=museum-pipeline-v2
PHOENIX_API_KEY=


# --- Canonical CPU deployment ----------------------------------------------
# These values control infra/cpu/compose.yml. Override when required.
POSTGRES_IMAGE=postgres:16
EMBEDDING_PORT=8081
PRESIGN_PORT=8082

# Optional GND/OpenSearch profile.
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0
OPENSEARCH_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g

# Embedding model cache / model access.
HF_HOME=/models/huggingface
HF_TOKEN=
SIGLIP_ID=google/siglip2-giant-opt-patch16-384
DINO_ID=facebook/dinov3-vitl16-pretrain-lvd1689m
BGE_ID=BAAI/bge-m3
IMG_TIMEOUT=30


# --- CPU deployment identity -------------------------------------------------
# Allows multiple independent deployments on one Docker host.
CPU_COMPOSE_PROJECT=museum-pipeline

# OpenSearch reference runtime
DISABLE_INSTALL_DEMO_CONFIG=true
DISABLE_SECURITY_PLUGIN=true
